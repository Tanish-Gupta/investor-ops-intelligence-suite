# Copy to .env and fill in. Never commit .env.

# --- LLM (LiteLLM model strings) ---
LLM_PRIMARY=gemini/gemini-3.8-flash
LLM_FALLBACK=groq/openai/gpt-oss-120b
LLM_VOICE_NLU=groq/openai/gpt-oss-20b
LLM_JUDGE=gemini/gemini-pro-latest
# opt-in: LLM judge for evals (faithfulness, relevance, tone); off = deterministic proxies
EVAL_LLM_JUDGE=false
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Retrieval (Pillar A) ---
EMBED_PROVIDER=local
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANK_MODEL=BAAI/bge-reranker-v2-m3
TOP_K=5
MIN_RELEVANCE=0.0

# --- Voice (Pillar B) ---
STT_MODEL=groq/whisper-large-v3-turbo
TTS_VOICE=en-IN-NeerjaNeural
# Opt-in: LLM NLU fallback for the voice agent when the rules are unsure
VOICE_LLM_ENABLED=false
# Opt-in: mic input via Groq Whisper (needs GROQ_API_KEY) and spoken replies via edge-tts
VOICE_STT_ENABLED=false
VOICE_TTS_ENABLED=false

# --- Pulse (M2) ---
PULSE_MAX_WORDS=250
PULSE_ACTION_IDEAS=3
PULSE_AUTOBUILD=true
# Opt-in: LLM theme classifier + per-theme summaries / action ideas (keyword/template otherwise)
PULSE_LLM_ENABLED=false

TIMEZONE=Asia/Kolkata

# --- Safety / observability ---
PII_NLP_MODEL=blank:en
PII_SCORE_THRESHOLD=0.4
GUARD_LLM_ENABLED=true
PHOENIX_TRACING=false
LOG_LEVEL=INFO

# --- MCP / HITL (Pillar C) ---
ADAPTER_MODE=mock
MCP_SERVER_TARGET=inprocess
MCP_CALL_TIMEOUT_S=10
# Google mode only
GOOGLE_PREBOOKING_DOC_ID=
GOOGLE_CALENDAR_ID=primary
# OAuth (default) or service account, as in M3
GOOGLE_CLIENT_SECRETS_PATH=secrets/client_secret.json
GOOGLE_TOKEN_PATH=secrets/token.json
GOOGLE_SERVICE_ACCOUNT_FILE=
ADVISOR_EMAIL=advisor@example.com
